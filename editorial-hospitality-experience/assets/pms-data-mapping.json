{
  "$schema": "draft-2020-12/schema",
  "title": "PMSDataMappingSchema",
  "description": "Transforms raw PMS codes into plain-language luxury hospitality UI cards",
  "type": "object",
  "properties": {
    "rateCodeTransformations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rawPmsCode": { "type": "string", "example": "BAR-BB-NONREF-3N" },
          "cleanCategory": { "type": "string", "enum": ["Flexible", "Advance Purchase", "Curated Package"] },
          "uiDisplayName": { "type": "string", "example": "Stay & Daily Breakfast" },
          "plainLanguageSummary": { "type": "string", "example": "Includes daily artisanal breakfast for two with complete flexibility to modify up to 72 hours prior to arrival." },
          "cancellationRefundable": { "type": "boolean" },
          "cancellationNoticeHours": { "type": "integer" },
          "depositRequiredPercent": { "type": "number" },
          "badgeToken": { "type": "string", "example": "DIRECT_PERK_INCLUDED" }
        },
        "required": ["rawPmsCode", "cleanCategory", "uiDisplayName", "plainLanguageSummary", "cancellationRefundable"]
      }
    },
    "taxAndFeeCalculationModel": {
      "type": "object",
      "properties": {
        "pricingDisplayMode": { "type": "string", "enum": ["TOTAL_TRANSPARENT_STAY", "NIGHTLY_INCLUSIVE"] },
        "autoIncludeMandatoryTaxes": { "type": "boolean", "default": true },
        "autoIncludeResortFees": { "type": "boolean", "default": true },
        "breakdownVisibility": { "type": "string", "enum": ["EXPANDABLE_OVERLAY", "ALWAYS_INLINE"] }
      }
    }
  }
}
